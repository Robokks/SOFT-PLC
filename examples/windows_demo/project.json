  "blocks": [
    {"name":"FB_Motor","kind":"FB","declarations":"VAR_INPUT\n Enable : BOOL;\nEND_VAR\nVAR_OUTPUT\n Ready : BOOL;\nEND_VAR\nVAR\n RunScans : DINT;\nEND_VAR", "networks":[
      {"title":"Motor state","language":"SCL","source":"IF Enable THEN\n RunScans := RunScans + 1;\nELSE\n RunScans := 0;\nEND_IF;\nReady := Enable;"}
    ]},
